# Шаблон реквизитов release-ключа Android.
#
# 1. Скопируйте файл в android/key.properties (он в .gitignore).
# 2. Создайте ключ:
#      keytool -genkeypair -v -keystore android/key.jks -keyalg RSA \
#        -keysize 2048 -validity 10000 -alias uruncalc
# 3. Заполните значения ниже и сохраните key.jks в надёжном месте.
#
# Без android/key.properties release-сборка подписывается отладочным ключом —
# такой APK нельзя публиковать.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=uruncalc
storeFile=../key.jks
